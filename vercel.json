{
  "builds": [
    { "src": "public/index.html", "use": "@vercel/static" },
    { "src": "api/backend.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/security-bridge.js", "dest": "/public/security-bridge.js" },
    { "src": "/manifest.json", "dest": "/public/manifest.json" },
    { "src": "/sw.js", "dest": "/public/sw.js" },
    { "src": "/api/(.*)", "dest": "/api/backend.js" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
